{
  "name": "archify-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "vite build",
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "bench": "node bench/large-diagram.mjs",
    "inventory": "node scripts/generate-capability-inventory.mjs",
    "check:release": "node scripts/release-check.mjs",
    "check:release:browser": "node scripts/release-check.mjs --browser",
    "package:release": "npm run build && node scripts/package-release.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@playwright/test": "^1.55.0"
  }
}
